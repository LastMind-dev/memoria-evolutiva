{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lastmind.dev/memoria-evolutiva/schemas/contexto-v1.schema.json",
  "title": "Envelope neutro de contexto verificável",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "projeto", "pergunta", "perfil", "frescor", "orcamento_tokens",
    "tokens_estimados", "estrategias", "comparacao_sombra", "fontes", "codigo", "avisos",
    "acoes_permitidas"
  ],
  "properties": {
    "schema": { "const": 1 },
    "projeto": { "type": "string", "minLength": 1 },
    "pergunta": { "type": "string", "minLength": 1 },
    "perfil": {
      "enum": [
        "atendimento", "automacao-codigo", "engenharia-documentacao",
        "engenharia-leitura", "operacao-assistida"
      ]
    },
    "frescor": { "enum": ["confirmado", "parcial"] },
    "orcamento_tokens": { "type": "integer", "minimum": 64 },
    "tokens_estimados": { "type": "integer", "minimum": 0 },
    "estrategias": {
      "type": "array", "uniqueItems": true,
      "items": { "enum": ["estrutural", "literal", "literal-codigo", "semantica"] }
    },
    "comparacao_sombra": {
      "type": "object", "additionalProperties": false,
      "required": [
        "documentos_semanticos", "fragmentos_ranqueados",
        "fontes_documentais_entregues", "migracao_hindsight_liberada"
      ],
      "properties": {
        "documentos_semanticos": { "type": "integer", "minimum": 0 },
        "fragmentos_ranqueados": { "type": "integer", "minimum": 0 },
        "fontes_documentais_entregues": { "type": "integer", "minimum": 0 },
        "migracao_hindsight_liberada": { "const": false }
      }
    },
    "fontes": { "type": "array", "items": { "$ref": "#/$defs/fonte" } },
    "codigo": { "type": "array", "items": { "$ref": "#/$defs/codigo" } },
    "avisos": { "type": "array", "items": { "type": "string" } },
    "acoes_permitidas": { "type": "array", "maxItems": 0 }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "estrategias": {
      "type": "array", "uniqueItems": true,
      "items": { "enum": ["estrutural", "literal", "literal-codigo", "semantica"] }
    },
    "fonte": {
      "type": "object", "additionalProperties": false,
      "required": [
        "source_uri", "source_commit", "source_sha256", "doc_id", "doc_tipo",
        "status", "fragment_id", "conteudo_sha256", "trecho", "truncado",
        "estrategias", "pontuacao"
      ],
      "properties": {
        "source_uri": { "type": "string", "pattern": "^docs/.+#.+" },
        "source_commit": { "type": ["string", "null"] },
        "source_sha256": { "$ref": "#/$defs/sha256" },
        "doc_id": { "type": "string", "minLength": 1 },
        "doc_tipo": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "minLength": 1 },
        "fragment_id": { "type": "string", "minLength": 1 },
        "conteudo_sha256": { "$ref": "#/$defs/sha256" },
        "trecho": { "type": "string", "minLength": 1 },
        "truncado": { "type": "boolean" },
        "estrategias": { "$ref": "#/$defs/estrategias" },
        "pontuacao": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "codigo": {
      "type": "object", "additionalProperties": false,
      "required": [
        "source_uri", "source_sha256", "no_id", "trecho", "estrategias",
        "conteudo_sha256", "truncado", "pontuacao"
      ],
      "properties": {
        "source_uri": { "type": "string", "pattern": "#L[1-9][0-9]*$" },
        "source_sha256": { "$ref": "#/$defs/sha256" },
        "no_id": { "type": ["string", "null"] },
        "trecho": { "type": "string", "minLength": 1 },
        "estrategias": { "$ref": "#/$defs/estrategias" },
        "conteudo_sha256": { "$ref": "#/$defs/sha256" },
        "truncado": { "type": "boolean" },
        "pontuacao": { "type": "number", "exclusiveMinimum": 0 }
      }
    }
  }
}
