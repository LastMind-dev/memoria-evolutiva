{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lastmind.dev/memoria-evolutiva/schemas/manifesto-fragmentos-v1.schema.json",
  "title": "Manifesto determinístico de fragmentos da memória evolutiva",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "projeto",
    "algoritmo",
    "perfil_fingerprint",
    "perfil_indice",
    "documentos",
    "fragmentos",
    "assinatura"
  ],
  "properties": {
    "schema": { "const": 1 },
    "projeto": { "type": "string", "minLength": 1 },
    "algoritmo": { "type": "string", "minLength": 1 },
    "perfil_fingerprint": { "$ref": "#/$defs/sha256" },
    "perfil_indice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_palavras", "min_palavras", "especiais", "hindsight"],
      "properties": {
        "max_palavras": { "type": "integer", "minimum": 1 },
        "min_palavras": { "type": "integer", "minimum": 0 },
        "especiais": {
          "type": "object",
          "additionalProperties": false,
          "required": ["aberto", "glossario", "cronologia"],
          "properties": {
            "aberto": { "const": "item" },
            "glossario": { "const": "termo" },
            "cronologia": { "const": "entrada" }
          }
        },
        "hindsight": {
          "type": "object",
          "additionalProperties": false,
          "required": ["modo", "contrato", "embedding_provedor", "embedding_modelo"],
          "properties": {
            "modo": { "const": "sombra" },
            "contrato": { "const": 1 },
            "embedding_provedor": { "type": "string", "minLength": 1 },
            "embedding_modelo": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "documentos": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["doc_id", "doc_tipo", "doc_status", "source_sha256", "fragmentos"],
        "properties": {
          "doc_id": { "type": "string", "minLength": 1 },
          "doc_tipo": { "type": "string", "minLength": 1 },
          "doc_status": { "type": "string", "minLength": 1 },
          "source_sha256": { "$ref": "#/$defs/sha256" },
          "fragmentos": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "fragmentos": {
      "type": "array",
      "items": { "$ref": "#/$defs/fragmento" }
    },
    "assinatura": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "fragmento": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fragment_id",
        "source_uri",
        "source_sha256",
        "conteudo_sha256",
        "doc_id",
        "doc_tipo",
        "doc_status",
        "ordem",
        "texto"
      ],
      "properties": {
        "fragment_id": { "type": "string", "minLength": 1 },
        "source_uri": { "type": "string", "pattern": "^docs/" },
        "source_sha256": { "$ref": "#/$defs/sha256" },
        "conteudo_sha256": { "$ref": "#/$defs/sha256" },
        "doc_id": { "type": "string", "minLength": 1 },
        "doc_tipo": { "type": "string", "minLength": 1 },
        "doc_status": { "type": "string", "minLength": 1 },
        "ordem": { "type": "integer", "minimum": 0 },
        "classificacao": {
          "type": "string",
          "enum": ["publico", "interno", "restrito"]
        },
        "audience": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "texto": { "type": "string", "minLength": 1 }
      }
    }
  }
}
